{
  "name": "vocaloid-mcp-server",
  "version": "1.0.0",
  "description": "Agent-native MCP for composing, tuning, rendering, mixing, and auditing native VOCALOID3/4 projects",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "vocaloid-mcp-server": "dist/src/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:native": "scripts/build-native.sh",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "compose:prompt": "npm run build && node scripts/render-composition-agent-prompt.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js scripts/lib/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xmldom/xmldom": "0.9.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
