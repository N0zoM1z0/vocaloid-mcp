{
  "name": "vocaloid-mcp-server",
  "version": "1.0.0",
  "description": "Local MCP server for inspecting and safely editing VOCALOID VSQX projects",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "vocaloid-mcp-server": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "compose:intent-demo": "npm run build && node scripts/compose-intent-demo.mjs",
    "compose:distant-lights": "npm run build && node scripts/compose-distant-lights.mjs",
    "compose:prompt": "npm run build && node scripts/render-composition-agent-prompt.mjs",
    "eval:styles": "node scripts/generate-style-evals.mjs",
    "eval:intent-first": "npm run build && node scripts/evaluate-intent-first-benchmark.mjs",
    "eval:intent-first:finalize-trace": "npm run build && node scripts/finalize-intent-first-trace.mjs",
    "eval:intent-first:prompt": "npm run build && node scripts/render-intent-first-prompt.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xmldom/xmldom": "0.9.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
