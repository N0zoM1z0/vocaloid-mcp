# Dependencies and build output
node_modules/
dist/
build/

# Test and language caches
.test-*/
__pycache__/
*.py[cod]

# Local configuration and logs
.env
.env.*
!.env.example
*.log

# Generated evaluation output and agent traces are local-only at every depth.
# Durable, Git-safe evidence belongs in artifacts/creative-records/ instead.
artifacts/evals/

# Final listening audio is local-only and must never be tracked/published.
artifacts/songs/

# Final native projects under artifacts/vsqxs/ are intentionally trackable.

# Local diagnostic screenshots
/image*.png

# IDA databases and crash artifacts
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
core
core.*

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
